# Firebase web app config
# Firebase Console > Project Settings (gear icon) > Your apps > Web app > SDK setup
# Copy this file to .env and paste in your values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Python AI server (YOLOv8 / CNN / camera). Optional — defaults to localhost:7860.
#
# The value is baked in at build time, so after changing it you must rebuild
# and re-sync (`npm run sync`) for the native apps to pick it up.
#
#   web + iOS simulator   http://localhost:7860   (default — nothing to set)
#   Android emulator      http://10.0.2.2:7860    (10.0.2.2 is the host's localhost)
#   physical device       http://<your-LAN-IP>:7860
#
# Cleartext HTTP to these loopback hosts is allowed on Android via
# android/app/src/main/res/xml/network_security_config.xml. A LAN IP or public
# host needs to be added there, or served over https.
# VITE_SERVER_URL=http://localhost:7860
